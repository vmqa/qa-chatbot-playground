# OpenAI Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_MAX_INPUT_TOKENS=2200
OPENAI_MAX_TOTAL_TOKENS=2800
ENABLE_IP_DAILY_TOKEN_LIMIT=true
IP_DAILY_TOKEN_LIMIT=10000

# CORS Configuration
# Local development:
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGIN_REGEX=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Production (Render): replace with your actual domains
# ALLOWED_ORIGINS=https://your-app.pages.dev
# ALLOWED_HOSTS=your-app.onrender.com
# Cloudflare Pages preview deployments (allows all PR preview URLs):
# ALLOWED_ORIGIN_REGEX=https://[a-z0-9-]+\.your-app\.pages\.dev

# Security
ENFORCE_HTTPS=false
# Production: set to true on Railway
# ENFORCE_HTTPS=true

# Rate Limiting
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW=3600
